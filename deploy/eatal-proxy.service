[Unit]
Description=EatAll POC absorption honeypot proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/eatal
ExecStart=/opt/eatal/bin/eatal-proxy -config /opt/eatal/config/config.yaml
Restart=always
RestartSec=3
# 低端口需要特权；按需放开
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/eatal/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
